---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar";
import Footer from "../../components/presentation/footerFree";
import { getCollection, render } from "astro:content";
import { WhatsAppIcon } from "../../components/icons";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fecha = post.data.fecha.toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout title={post.data.titulo} metaDescription={post.data.bajada}>
  <Navbar client:only="react" />
  <article class="container mx-auto max-w-3xl px-6 py-16">
    <p class="text-xs font-semibold uppercase tracking-widest text-[#1a56a0]">
      {post.data.tema}
    </p>
    <h1 class="mt-3 text-3xl font-bold leading-tight text-[#0a325c] sm:text-4xl">
      {post.data.titulo}
    </h1>
    <p class="mt-4 text-xl leading-relaxed text-gray-600">{post.data.bajada}</p>
    <p class="mt-6 text-sm text-gray-500">
      Por <span class="font-semibold text-gray-800">{post.data.autor}</span>
      · {post.data.cargo}
      · {fecha}
      · {post.data.lectura} de lectura
    </p>
    {post.data.portada && (
      <img
        src={post.data.portada}
        alt={post.data.portadaAlt || post.data.titulo}
        class="mt-8 w-full rounded-2xl object-cover"
      />
    )}
    <div class="article-body mt-10">
      <Content />
    </div>
    <aside class="mt-14 rounded-2xl border border-gray-200 bg-[#eef2f6] p-8">
      <p class="text-xl font-bold text-[#0a325c]">¿Le resuena este caso?</p>
      <p class="mt-2 text-gray-600">
        Escribimos desde la planta. Si quiere revisar un proceso a la medida, puede escribirnos.
      </p>
      <a
        href={`https://wa.me/573113608491?text=${encodeURIComponent(`Hola, leí “${post.data.titulo}” en crsolin.com`)}`}
        class="mt-5 inline-flex items-center gap-2 rounded-lg bg-green-600 px-5 py-3 text-sm font-semibold text-white hover:bg-green-500"
      >
        <WhatsAppIcon className="h-5 w-5" />
        WhatsApp
      </a>
    </aside>
    <p class="mt-8">
      <a href="/blog" class="text-sm font-semibold text-[#1a56a0] hover:underline">← Todos los artículos</a>
    </p>
  </article>
  <Footer client:only="react" />
</Layout>
