---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar";
import Footer from "../../components/presentation/footerFree";
import { getCollection, render } from "astro:content";
import { WhatsAppIcon } from "../../components/icons";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fecha = post.data.fecha.toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout title={post.data.titulo} metaDescription={post.data.bajada}>
  <Navbar client:only="react" />
  <article class="container mx-auto max-w-3xl px-6 py-14 lg:py-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-[var(--blue)]">
      <a href="/blog" class="hover:underline">Del oficio</a>
      <span class="mx-2 text-[var(--muted)]">/</span>
      {post.data.tema}
    </p>
    <h1 class="mt-4 text-balance text-3xl font-bold leading-tight text-[var(--navy)] sm:text-4xl">
      {post.data.titulo}
    </h1>
    <p class="mt-5 text-xl leading-relaxed text-[var(--muted)]">{post.data.bajada}</p>
    <p class="mt-6 text-sm text-[var(--muted)]">
      {post.data.autor}
      <span class="mx-1.5">·</span>
      {post.data.cargo}
      <span class="mx-1.5">·</span>
      {fecha}
      <span class="mx-1.5">·</span>
      {post.data.lectura} de lectura
    </p>
    {post.data.portada && (
      <img
        src={post.data.portada}
        alt={post.data.portadaAlt || post.data.titulo}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
        class="mt-8 block aspect-[16/9] h-auto w-full max-w-full rounded-2xl object-cover"
      />
    )}
    <div class="article-body mt-10">
      <Content />
    </div>
    <aside class="mt-14 rounded-2xl border border-gray-200 bg-white p-7 sm:p-8">
      <p class="text-lg font-bold text-[var(--navy)]">Si esto le suena a su planta</p>
      <p class="mt-2 text-base leading-relaxed text-[var(--muted)]">
        Carlos Adrián atiende por WhatsApp. Una foto del equipo y qué está pasando en el turno alcanza para orientar el alcance.
      </p>
      <a
        href={`https://wa.me/573113608491?text=${encodeURIComponent(`Hola Carlos, leí “${post.data.titulo}” en crsolin.com`)}`}
        class="mt-5 inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg bg-green-600 px-5 py-3 text-sm font-semibold text-white hover:bg-green-500"
      >
        <WhatsAppIcon className="h-5 w-5" />
        Escribir por WhatsApp
      </a>
    </aside>
    <p class="mt-8 pb-8">
      <a href="/blog" class="text-sm font-semibold text-[var(--blue)] hover:underline">← Volver a los artículos</a>
    </p>
  </article>
  <Footer client:only="react" />
</Layout>
