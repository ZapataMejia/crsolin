---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar";
import Footer from "../../components/presentation/footerFree";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
---

<Layout title="Blog" metaDescription="Notas técnicas de CR Soluciones Industriales.">
  <Navbar client:only="react" />
  <main class="container mx-auto px-6 py-16">
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-400">Blog</p>
    <h1 class="text-3xl font-bold text-gray-900 md:text-4xl">Notas del oficio</h1>
    <p class="mt-3 max-w-xl text-gray-500">
      Artículos a la medida del trabajo en planta. Para publicar uno nuevo: un archivo markdown en
      <code class="text-sm">src/content/blog/</code>.
    </p>
    <div class="mt-12 space-y-6">
      {posts.map((p) => (
        <a href={`/blog/${p.id}`} class="block rounded-2xl border border-gray-200 bg-white p-8 hover:border-gray-900">
          <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">
            {p.data.fecha.toISOString().slice(0, 10)} · {p.data.tema}
          </p>
          <h2 class="mt-2 text-2xl font-bold text-gray-900">{p.data.titulo}</h2>
          <p class="mt-2 text-gray-500">{p.data.bajada}</p>
        </a>
      ))}
    </div>
  </main>
  <Footer client:only="react" />
</Layout>
