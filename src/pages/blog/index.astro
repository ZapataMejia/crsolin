---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar";
import Footer from "../../components/presentation/footerFree";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
const dest = posts[0];
const resto = posts.slice(1);

const fecha = (d: Date) =>
  d.toLocaleDateString("es-CO", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---

<Layout
  title="Del oficio"
  metaDescription="Notas de planta de Carlos Adrián Ramírez Gómez. Cuellos de botella, mezclado, montaje y el trabajo a la medida en caucho y polímeros."
>
  <Navbar client:only="react" />
  <main class="bg-[var(--mist)]">
    <header class="container mx-auto px-6 pb-10 pt-14 lg:pt-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-[var(--blue)]">
        Del oficio
      </p>
      <h1 class="mt-3 max-w-3xl text-balance text-3xl font-bold leading-tight text-[var(--navy)] md:text-5xl">
        Lo que se ve cuando uno entra a planta
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--muted)]">
        Escribe Carlos Adrián Ramírez Gómez. Ingeniería mecánica, Medellín.
        Casos de caucho y polímeros: dónde se detiene el flujo, qué recambio
        ya no llega y cómo se acompaña el montaje. Sin catálogo. Desde el piso.
      </p>
    </header>

    {dest && (
      <section class="container mx-auto px-6 pb-8">
        <a
          href={`/blog/${dest.id}`}
          class="group grid overflow-hidden rounded-3xl border border-gray-200 bg-white lg:grid-cols-2"
        >
          {dest.data.portada && (
            <div class="relative aspect-[16/9] bg-[var(--mist)]">
              <img
                src={dest.data.portada}
                alt={dest.data.portadaAlt || dest.data.titulo}
                width="1280"
                height="720"
                fetchpriority="high"
                decoding="async"
                class="absolute inset-0 block h-full w-full max-w-full object-cover"
              />
            </div>
          )}
          <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
            <p class="text-xs font-semibold uppercase tracking-widest text-[var(--blue)]">
              {dest.data.tema} · {fecha(dest.data.fecha)}
            </p>
            <h2 class="mt-3 text-2xl font-bold leading-snug text-[var(--navy)] md:text-3xl group-hover:text-[var(--blue)]">
              {dest.data.titulo}
            </h2>
            <p class="mt-4 text-base leading-relaxed text-[var(--muted)]">
              {dest.data.bajada}
            </p>
            <p class="mt-6 text-sm text-[var(--muted)]">
              {dest.data.autor} · {dest.data.lectura} de lectura
            </p>
            <span class="mt-6 inline-flex text-sm font-semibold text-[var(--blue)]">
              Leer artículo →
            </span>
          </div>
        </a>
      </section>
    )}

    <section class="container mx-auto px-6 pb-20">
      <div class="grid gap-6 md:grid-cols-2">
        {resto.map((p) => (
          <a
            href={`/blog/${p.id}`}
            class="group flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white"
          >
            {p.data.portada && (
              <div class="relative aspect-[16/9] bg-[var(--mist)]">
                <img
                  src={p.data.portada}
                  alt={p.data.portadaAlt || p.data.titulo}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 block h-full w-full max-w-full object-cover"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-[var(--blue)]">
                {p.data.tema} · {fecha(p.data.fecha)}
              </p>
              <h2 class="mt-2 text-xl font-bold leading-snug text-[var(--navy)] group-hover:text-[var(--blue)]">
                {p.data.titulo}
              </h2>
              <p class="mt-3 flex-1 text-base leading-relaxed text-[var(--muted)]">
                {p.data.bajada}
              </p>
              <p class="mt-4 text-sm text-[var(--muted)]">{p.data.lectura} de lectura</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer client:only="react" />
</Layout>
