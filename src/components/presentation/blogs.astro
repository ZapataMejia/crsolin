---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
const dest = posts[0];
const mas = posts.slice(1, 3);
---

{dest && (
  <section id="blog" class="border-y border-gray-100 bg-gray-50 px-6 py-16">
    <div class="container mx-auto">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-[#1a56a0]">Blog</p>
          <h2 class="mt-1 text-3xl font-bold text-gray-900">Lo que escribimos del oficio</h2>
        </div>
        <a href="/blog" class="text-sm font-semibold text-[#1a56a0] hover:underline">Ver todos</a>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <a
          href={`/blog/${dest.id}`}
          class="rounded-2xl border border-gray-200 bg-white p-8 lg:col-span-2 hover:border-[#1a56a0] hover:shadow-md"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-[#1a56a0]">{dest.data.tema}</p>
          <h3 class="mt-2 text-2xl font-bold leading-snug text-gray-900">{dest.data.titulo}</h3>
          <p class="mt-3 text-gray-600">{dest.data.bajada}</p>
          <p class="mt-3 text-sm text-gray-500">Por {dest.data.autor}</p>
          <span class="mt-6 inline-block text-sm font-semibold text-[#1a56a0]">Leer artículo →</span>
        </a>
        <div class="flex flex-col gap-6">
          {mas.map((p) => (
            <a href={`/blog/${p.id}`} class="rounded-2xl border border-gray-200 bg-white p-6 hover:border-[#1a56a0] hover:shadow-md">
              <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">{p.data.tema}</p>
              <h3 class="mt-2 font-bold text-gray-900">{p.data.titulo}</h3>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
