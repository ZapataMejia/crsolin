---
export interface Props {
  title: string;
  metaDescription?: string;
  canonical?: string;
}

const {
  title,
  metaDescription = "Consultoría y optimización de procesos productivos. Ingeniería mecánica aplicada, caucho y polímeros, Medellín.",
  canonical = "https://crsolin.com",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/brand/logo-mark.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title} | CR Soluciones Industriales</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={`${title} | CR Soluciones Industriales`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
  </head>
  <body class="overflow-x-hidden bg-[#eef2f6] antialiased">
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --navy: #0a325c;
    --navy-deep: #072444;
    --blue: #1a56a0;
    --mist: #eef2f6;
    --silver: #6b7785;
  }
  html { scroll-behavior: smooth; }
  body { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  section[id], header[id] { scroll-margin-top: 5rem; }
  .article-body p { margin: 0 0 1.25rem; line-height: 1.75; color: #374151; font-size: 1.125rem; }
  .article-body h2 { margin: 2.25rem 0 0.75rem; font-size: 1.5rem; font-weight: 700; color: #0a325c; line-height: 1.3; }
  .article-body h3 { margin: 1.75rem 0 0.5rem; font-size: 1.15rem; font-weight: 650; color: #0a325c; }
  .article-body ul { margin: 0 0 1.25rem; padding-left: 1.25rem; }
  .article-body li { margin: 0 0 0.4rem; line-height: 1.7; color: #374151; font-size: 1.125rem; }
  .article-body img { width: 100%; border-radius: 1rem; margin: 1.75rem 0; }
  .article-body figcaption { margin: -1rem 0 1.75rem; font-size: 0.875rem; color: #6b7785; }
  .article-body a { color: #1a56a0; text-decoration: underline; text-underline-offset: 3px; }
</style>
