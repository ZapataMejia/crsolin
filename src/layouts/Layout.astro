---
export interface Props {
  title: string;
  metaDescription?: string;
  canonical?: string;
}

const {
  title,
  metaDescription = "Consultoría y optimización de procesos productivos. Ingeniería mecánica aplicada, caucho y polímeros, Medellín.",
  canonical = "https://crsolin.com",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/brand/logo-mark.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title} | CR Soluciones Industriales</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={`${title} | CR Soluciones Industriales`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      try {
        if (location.hash) {
          sessionStorage.setItem(
            "cr-scroll",
            decodeURIComponent(location.hash.slice(1)),
          );
          history.replaceState(null, "", location.pathname + location.search);
        }
      } catch (e) {}
    </script>
  </head>
  <body class="overflow-x-hidden bg-[#eef2f6] antialiased">
    <slot />
    <script is:inline>
      (() => {
        const STORE = "cr-scroll";
        let scrollGen = 0;

        const reduced = () =>
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const cleanUrl = () => {
          if (!location.hash) return;
          history.replaceState(null, "", location.pathname + location.search);
        };

        const waitForId = (id) => {
          const { promise, resolve } = Promise.withResolvers();
          const started = Date.now();
          const tick = () => {
            const el = document.getElementById(id);
            if (el) {
              resolve(el);
              return;
            }
            if (Date.now() - started > 4000) {
              resolve(null);
              return;
            }
            requestAnimationFrame(tick);
          };
          tick();
          return promise;
        };

        const goToId = async (id) => {
          const el = await waitForId(id);
          if (!el) return;
          const gen = ++scrollGen;
          if (el.tabIndex < 0) el.tabIndex = -1;
          await el.scrollIntoView({
            behavior: reduced() ? "instant" : "smooth",
            block: "start",
          });
          if (gen !== scrollGen) return;
          el.focus({ preventScroll: true });
        };

        const samePath = (url) => {
          const a = url.pathname.replace(/\/$/, "") || "/";
          const b = location.pathname.replace(/\/$/, "") || "/";
          return a === b;
        };

        document.addEventListener(
          "click",
          (e) => {
          if (e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest("a[href]");
          if (!a) return;
          let url;
          try {
            url = new URL(a.href, location.href);
          } catch {
            return;
          }
          if (url.origin !== location.origin) return;
          const id = decodeURIComponent((url.hash || "").slice(1));
          if (!id) return;
          e.preventDefault();
          if (samePath(url)) {
            cleanUrl();
            goToId(id);
            return;
          }
          try {
            sessionStorage.setItem(STORE, id);
          } catch {}
          location.assign(url.pathname + url.search);
        },
          true,
        );

        window.addEventListener("hashchange", () => {
          const id = decodeURIComponent((location.hash || "").slice(1));
          cleanUrl();
          if (id) goToId(id);
        });

        let pending = null;
        try {
          pending = sessionStorage.getItem(STORE);
          sessionStorage.removeItem(STORE);
        } catch {}
        if (!pending && location.hash) {
          pending = decodeURIComponent(location.hash.slice(1));
        }
        cleanUrl();
        if (pending) {
          goToId(pending);
          window.addEventListener("load", () => goToId(pending), { once: true });
        }
      })();
    </script>
  </body>
</html>
<style is:global>
  :root {
    --navy: #0a325c;
    --navy-deep: #072444;
    --blue: #1a56a0;
    --mist: #eef2f6;
    --silver: #6b7785;
  }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
  body { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  section[id], header[id] { scroll-margin-top: 6.5rem; }
  .article-body p { margin: 0 0 1.25rem; line-height: 1.75; color: #374151; font-size: 1.125rem; }
  .article-body h2 { margin: 2.25rem 0 0.75rem; font-size: 1.5rem; font-weight: 700; color: #0a325c; line-height: 1.3; }
  .article-body h3 { margin: 1.75rem 0 0.5rem; font-size: 1.15rem; font-weight: 650; color: #0a325c; }
  .article-body ul { margin: 0 0 1.25rem; padding-left: 1.25rem; }
  .article-body li { margin: 0 0 0.4rem; line-height: 1.7; color: #374151; font-size: 1.125rem; }
  .article-body img { width: 100%; border-radius: 1rem; margin: 1.75rem 0; }
  .article-body figcaption { margin: -1rem 0 1.75rem; font-size: 0.875rem; color: #6b7785; }
  .article-body a { color: #1a56a0; text-decoration: underline; text-underline-offset: 3px; }
</style>
