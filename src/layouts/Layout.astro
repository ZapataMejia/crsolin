---
export interface Props {
  title: string;
  metaDescription?: string;
  canonical?: string;
}

const {
  title,
  metaDescription = "Consultoría y optimización de procesos productivos. Administración empresarial por outsourcing. Caucho y polímeros, Medellín.",
  canonical = "https://crsolin.com",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const meta = document.querySelector('meta[name="color-scheme"]');
        const stored = localStorage.getItem("color-scheme");
        if (meta && (stored === "light" || stored === "dark")) {
          meta.content = stored;
        }
      } catch (e) {}
    </script>
    <link rel="icon" type="image/png" href="/brand/logo-mark.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title} | CR Soluciones Industriales</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={`${title} | CR Soluciones Industriales`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      try {
        if (location.hash) {
          sessionStorage.setItem(
            "cr-scroll",
            decodeURIComponent(location.hash.slice(1)),
          );
          history.replaceState(null, "", location.pathname + location.search);
        }
      } catch (e) {}
    </script>
  </head>
  <body class="overflow-x-hidden antialiased">
    <slot />
    <script is:inline>
      (() => {
        const STORE = "cr-scroll";
        let scrollGen = 0;

        const reduced = () =>
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const cleanUrl = () => {
          if (!location.hash) return;
          history.replaceState(null, "", location.pathname + location.search);
        };

        const waitForId = (id) => {
          const { promise, resolve } = Promise.withResolvers();
          const started = Date.now();
          const tick = () => {
            const el = document.getElementById(id);
            if (el) {
              resolve(el);
              return;
            }
            if (Date.now() - started > 4000) {
              resolve(null);
              return;
            }
            requestAnimationFrame(tick);
          };
          tick();
          return promise;
        };

        const goToId = async (id) => {
          const el = await waitForId(id);
          if (!el) return;
          const gen = ++scrollGen;
          await el.scrollIntoView({
            behavior: reduced() ? "instant" : "smooth",
            block: "start",
          });
          if (gen !== scrollGen) return;
          const heading = el.querySelector("h1, h2");
          if (!heading) return;
          if (heading.tabIndex < 0) heading.tabIndex = -1;
          heading.focus({ preventScroll: true });
        };

        const samePath = (url) => {
          const a = url.pathname.replace(/\/$/, "") || "/";
          const b = location.pathname.replace(/\/$/, "") || "/";
          return a === b;
        };

        document.addEventListener(
          "click",
          (e) => {
          if (e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest("a[href]");
          if (!a) return;
          let url;
          try {
            url = new URL(a.href, location.href);
          } catch {
            return;
          }
          if (url.origin !== location.origin) return;
          const path = url.pathname.replace(/\/$/, "") || "/";
          const here = location.pathname.replace(/\/$/, "") || "/";
          if (path === "/" && !url.hash && here === "/") {
            e.preventDefault();
            cleanUrl();
            window.scrollTo({
              top: 0,
              behavior: reduced() ? "instant" : "smooth",
            });
            return;
          }
          const id = decodeURIComponent((url.hash || "").slice(1));
          if (!id) return;
          e.preventDefault();
          if (samePath(url)) {
            cleanUrl();
            goToId(id);
            return;
          }
          try {
            sessionStorage.setItem(STORE, id);
          } catch {}
          location.assign(url.pathname + url.search);
        },
          true,
        );

        window.addEventListener("hashchange", () => {
          const id = decodeURIComponent((location.hash || "").slice(1));
          cleanUrl();
          if (id) goToId(id);
        });

        let pending = null;
        try {
          pending = sessionStorage.getItem(STORE);
          sessionStorage.removeItem(STORE);
        } catch {}
        if (!pending && location.hash) {
          pending = decodeURIComponent(location.hash.slice(1));
        }
        cleanUrl();
        if (pending) {
          goToId(pending);
          window.addEventListener("load", () => goToId(pending), { once: true });
        }

        const themeMeta = document.querySelector('meta[name="color-scheme"]');
        const systemDark = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        const renderedDark = () => {
          const c = themeMeta && themeMeta.getAttribute("content");
          if (c === "dark") return true;
          if (c === "light") return false;
          return systemDark();
        };
        const applyTheme = (value) => {
          if (!themeMeta) return;
          if (value === "light" || value === "dark") {
            try {
              localStorage.setItem("color-scheme", value);
            } catch (e) {}
            themeMeta.setAttribute("content", value);
          } else {
            try {
              localStorage.removeItem("color-scheme");
            } catch (e) {}
            themeMeta.setAttribute("content", "light dark");
          }
        };
        document.addEventListener("click", (e) => {
          const btn = e.target.closest("[data-theme-toggle]");
          if (!btn) return;
          e.preventDefault();
          const wantDark = !renderedDark();
          if (wantDark === systemDark()) applyTheme(null);
          else applyTheme(wantDark ? "dark" : "light");
        });
        window.addEventListener("storage", (e) => {
          if (e.key !== "color-scheme" || !themeMeta) return;
          themeMeta.setAttribute(
            "content",
            e.newValue === "light" || e.newValue === "dark"
              ? e.newValue
              : "light dark",
          );
        });
      })();
    </script>
  </body>
</html>
<style is:global>
  :root {
    --navy-light: #0a325c;
    --navy-dark: #d5e4f6;
    --navy-deep: #072444;
    --blue-light: #1a56a0;
    --blue-dark: #8ec0f0;
    --mist-light: #eef2f6;
    --mist-dark: #0e1624;
    --surface-light: #ffffff;
    --surface-dark: #151d2c;
    --ink-light: #111827;
    --ink-dark: #e8eef6;
    --muted-light: #4b5563;
    --muted-dark: #b7c3d1;
    --border-light: #e5e7eb;
    --border-dark: #2c3a50;
    --navy: var(--navy-light);
    --blue: var(--blue-light);
    --mist: var(--mist-light);
    --surface: var(--surface-light);
    --ink: var(--ink-light);
    --muted: var(--muted-light);
    --border: var(--border-light);
    --silver: var(--muted);
    color-scheme: light dark;
    accent-color: var(--blue);
  }
  @supports (color: light-dark(#000, #fff)) {
    :root {
      --navy: light-dark(var(--navy-light), var(--navy-dark));
      --blue: light-dark(var(--blue-light), var(--blue-dark));
      --mist: light-dark(var(--mist-light), var(--mist-dark));
      --surface: light-dark(var(--surface-light), var(--surface-dark));
      --ink: light-dark(var(--ink-light), var(--ink-dark));
      --muted: light-dark(var(--muted-light), var(--muted-dark));
      --border: light-dark(var(--border-light), var(--border-dark));
    }
  }
  :root:has(> head > meta[name="color-scheme"][content="dark"]) {
    color-scheme: dark;
    --navy: var(--navy-dark);
    --blue: var(--blue-dark);
    --mist: var(--mist-dark);
    --surface: var(--surface-dark);
    --ink: var(--ink-dark);
    --muted: var(--muted-dark);
    --border: var(--border-dark);
  }
  :root:has(> head > meta[name="color-scheme"][content="light"]) {
    color-scheme: light;
    --navy: var(--navy-light);
    --blue: var(--blue-light);
    --mist: var(--mist-light);
    --surface: var(--surface-light);
    --ink: var(--ink-light);
    --muted: var(--muted-light);
    --border: var(--border-light);
  }
  @media (prefers-color-scheme: dark) {
    :root:not(:has(> head > meta[name="color-scheme"][content="light"])) {
      --navy: var(--navy-dark);
      --blue: var(--blue-dark);
      --mist: var(--mist-dark);
      --surface: var(--surface-dark);
      --ink: var(--ink-dark);
      --muted: var(--muted-dark);
      --border: var(--border-dark);
    }
  }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
  body {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    background: var(--mist);
    color: var(--ink);
  }
  section[id], header[id] { scroll-margin-top: 6.5rem; }
  header[id]:focus,
  section[id]:focus {
    outline: none;
  }
  h1:focus,
  h2:focus {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  h1:focus:not(:focus-visible),
  h2:focus:not(:focus-visible) {
    outline: none;
  }

  html .bg-white { background-color: var(--surface); }
  html .bg-gray-50 { background-color: var(--mist); }
  html .bg-\[\#eef2f6\] { background-color: var(--mist); }
  html .text-gray-900,
  html .text-\[\#0a325c\],
  html .text-\[\#0A325C\] { color: var(--navy); }
  html .text-gray-800 { color: var(--ink); }
  html .text-gray-700,
  html .text-gray-600,
  html .text-gray-500 { color: var(--muted); }
  html .text-gray-400 { color: var(--muted); }
  html .text-\[\#1a56a0\],
  html .text-\[\#1A56A0\] { color: var(--blue); }
  html .border-gray-100,
  html .border-gray-200 { border-color: var(--border); }
  html .hover\:bg-gray-100:hover { background-color: var(--mist); }

  .theme-icon-to-light { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not(:has(> head > meta[name="color-scheme"][content="light"])) .theme-icon-to-dark {
      display: none;
    }
    :root:not(:has(> head > meta[name="color-scheme"][content="light"])) .theme-icon-to-light {
      display: inline-flex;
    }
  }
  :root:has(> head > meta[name="color-scheme"][content="dark"]) .theme-icon-to-dark {
    display: none;
  }
  :root:has(> head > meta[name="color-scheme"][content="dark"]) .theme-icon-to-light {
    display: inline-flex;
  }
  :root:has(> head > meta[name="color-scheme"][content="light"]) .theme-icon-to-dark {
    display: inline-flex;
  }
  :root:has(> head > meta[name="color-scheme"][content="light"]) .theme-icon-to-light {
    display: none;
  }

  .site-nav {
    background-color: #ffffff;
  }
  .logo-nav-on-dark { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not(:has(> head > meta[name="color-scheme"][content="light"])) .logo-nav-on-light {
      display: none;
    }
    :root:not(:has(> head > meta[name="color-scheme"][content="light"])) .logo-nav-on-dark {
      display: block;
    }
    :root:not(:has(> head > meta[name="color-scheme"][content="light"])) .site-nav {
      background-color: #0a325c;
    }
  }
  :root:has(> head > meta[name="color-scheme"][content="dark"]) .logo-nav-on-light {
    display: none;
  }
  :root:has(> head > meta[name="color-scheme"][content="dark"]) .logo-nav-on-dark {
    display: block;
  }
  :root:has(> head > meta[name="color-scheme"][content="dark"]) .site-nav {
    background-color: #0a325c;
  }
  :root:has(> head > meta[name="color-scheme"][content="light"]) .logo-nav-on-light {
    display: block;
  }
  :root:has(> head > meta[name="color-scheme"][content="light"]) .logo-nav-on-dark {
    display: none;
  }
  :root:has(> head > meta[name="color-scheme"][content="light"]) .site-nav {
    background-color: #ffffff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .article-body p { margin: 0 0 1.25rem; line-height: 1.75; color: var(--muted); font-size: 1.125rem; }
  .article-body h2 { margin: 2.25rem 0 0.75rem; font-size: 1.5rem; font-weight: 700; color: var(--navy); line-height: 1.3; }
  .article-body h3 { margin: 1.75rem 0 0.5rem; font-size: 1.15rem; font-weight: 650; color: var(--navy); }
  .article-body ul,
  .article-body ol { margin: 0 0 1.25rem; padding-left: 1.25rem; }
  .article-body ol { list-style: decimal; }
  .article-body li { margin: 0 0 0.4rem; line-height: 1.7; color: var(--muted); font-size: 1.125rem; }
  .article-body img { width: 100%; border-radius: 1rem; margin: 1.75rem 0; }
  .article-body figcaption { margin: -1rem 0 1.75rem; font-size: 0.875rem; color: var(--muted); }
  .article-body a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
</style>
